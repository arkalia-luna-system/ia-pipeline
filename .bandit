# Configuration Bandit globale pour Athalia
# Ce fichier est utilisé par défaut par Bandit

exclude_dirs:
  - ".venv"
  - "venv"
  - "env"
  - "__pycache__"
  - ".git"
  - "node_modules"
  - "site-packages"
  - "dist-packages"

exclude:
  - "._*"  # Fichiers Apple Double
  - "*.pyc"  # Fichiers Python compilés
  - "*.pyo"  # Fichiers Python optimisés
  - "*.pyd"  # Fichiers Python dynamiques
  - "*.so"   # Bibliothèques partagées
  - "*.dll"  # Bibliothèques Windows
  - "*.dylib" # Bibliothèques macOS

# Configuration des tests
skips:
  - B101  # assert_used
  - B601  # paramiko_calls
  - B603  # subprocess_without_shell_equals_true

# Niveaux de confiance et sévérité
confidence:
  - HIGH
  - MEDIUM

severity:
  - HIGH
  - MEDIUM

# Format de sortie
output_format: json
output_file: bandit-report.json

# Options avancées
aggregate: true
verbose: false
debug: false 