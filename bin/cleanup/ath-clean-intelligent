#!/bin/bash
# 🌟 Nettoyage INTELLIGENT du Projet Athalia - VERSION INTELLIGENTE
# Version 1.0 - Nettoyage intelligent + Protection intelligente des fichiers

set -euo pipefail

# =============================================================================
# SECTION 1: CONFIGURATION INTELLIGENTE
# =============================================================================

# Couleurs
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Variables
CLEANED_COUNT=0
DRY_RUN_MODE=false
VERBOSE_MODE=false

# Détection des options
for arg in "$@"; do
    case $arg in
        --dry-run|-d)
            DRY_RUN_MODE=true
            ;;
        --verbose|-v)
            VERBOSE_MODE=true
            ;;
        --help|-h)
            echo "Usage: ath-clean-intelligent [OPTIONS]"
            echo "Options:"
            echo "  --dry-run, -d     Mode simulation (ne supprime rien)"
            echo "  --verbose, -v     Mode verbeux"
            echo "  --help, -h        Affiche cette aide"
            echo ""
            echo "🧠 INTELLIGENT: Ce script identifie et supprime intelligemment les fichiers inutiles"
            echo "🛡️  PROTECTION: Vos vrais fichiers importants sont préservés"
            exit 0
            ;;
    esac
done

# =============================================================================
# SECTION 2: FONCTIONS D'AFFICHAGE
# =============================================================================

print_header() {
    echo -e "${BLUE}🧠 Nettoyage INTELLIGENT Athalia${NC}"
    echo -e "${YELLOW}🛡️  Mode PROTECTION INTELLIGENTE activé${NC}"
    echo
}

print_section() {
    echo -e "${BLUE}📋 $1${NC}"
}

print_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

print_info() {
    echo -e "${BLUE}ℹ️  $1${NC}"
}

print_error() {
    echo -e "${RED}❌ $1${NC}"
}

print_verbose() {
    if [ "$VERBOSE_MODE" = true ]; then
        echo -e "${BLUE}🔍 $1${NC}"
    fi
}

# =============================================================================
# SECTION 3: INTELLIGENCE ARTIFICIELLE - DÉTECTION DES FICHIERS
# =============================================================================

# Fonction INTELLIGENTE pour identifier les vrais fichiers inutiles
is_truly_useless_file() {
    local file="$1"
    
    # 1. FICHIERS SYSTÈME MACOS (toujours inutiles)
    if [[ "$file" == *"/._"* ]] || [[ "$file" == *"/.DS_Store" ]] || [[ "$file" == *"/.!*" ]]; then
        return 0  # Vraiment inutile
    fi
    
    # 2. CACHES ET TEMPORAIRES (toujours inutiles)
    if [[ "$file" == *"/.pytest_cache/"* ]] || [[ "$file" == *"/.mypy_cache/"* ]] || \
       [[ "$file" == *"/.ruff_cache/"* ]] || [[ "$file" == *"/__pycache__/"* ]] || \
       [[ "$file" == *"/.coverage"* ]] || [[ "$file" == *"/coverage.xml"* ]] || \
       [[ "$file" == *"/htmlcov/"* ]] || [[ "$file" == *"/.tox/"* ]] || \
       [[ "$file" == *"/.cache/"* ]] || [[ "$file" == *"/build/"* ]] || \
       [[ "$file" == *"/dist/"* ]] || [[ "$file" == *"/*.egg-info/"* ]]; then
        return 0  # Vraiment inutile
    fi
    
    # 3. FICHIERS PYTHON COMPILÉS (toujours inutiles)
    if [[ "$file" == *.pyc ]] || [[ "$file" == *.pyo ]]; then
        return 0  # Vraiment inutile
    fi
    
    # 4. FICHIERS TEMPORAIRES (toujours inutiles)
    if [[ "$file" == *.tmp ]] || [[ "$file" == *.temp ]] || [[ "$file" == *.swp ]] || \
       [[ "$file" == *.swo ]] || [[ "$file" == *~ ]] || [[ "$file" == *.bak ]]; then
        return 0  # Vraiment inutile
    fi
    
    # 5. FICHIERS DE LOGS TEMPORAIRES (toujours inutiles)
    if [[ "$file" == *.log.tmp ]] || [[ "$file" == *.out.tmp ]] || [[ "$file" == *.err.tmp ]]; then
        return 0  # Vraiment inutile
    fi
    
    # 6. FICHIERS CORROMPUS (toujours inutiles)
    if [[ "$file" == *.corrupt ]] || [[ "$file" == *.broken ]] || [[ "$file" == *.f\(f\) ]]; then
        return 0  # Vraiment inutile
    fi
    
    # 7. FICHIERS DE COUVERTURE SPÉCIFIQUES (toujours inutiles)
    if [[ "$file" == .coverage.Mac.* ]] || [[ "$file" == .coverage.* ]]; then
        return 0  # Vraiment inutile
    fi
    
    # 8. FICHIERS D'ÉDITEURS TEMPORAIRES (toujours inutiles)
    if [[ "$file" == *.sublime-* ]] || [[ "$file" == .editorconfig.tmp ]]; then
        return 0  # Vraiment inutile
    fi
    
    # 9. FICHIERS NULL (toujours inutiles)
    if [[ "$file" == *.null ]] || [[ "$file" == *.zero ]]; then
        return 0  # Vraiment inutile
    fi
    
    # 10. FICHIERS DE PROCESSUS INTERROMPUS (toujours inutiles)
    if [[ "$file" == .* ]] && [[ ! "$file" == .git* ]] && [[ ! "$file" == .venv* ]] && [[ ! "$file" == .env* ]]; then
        # Vérifier si c'est un fichier de processus interrompu
        if [[ "$file" =~ \.[0-9]+$ ]] || [[ "$file" =~ \.pid$ ]]; then
            return 0  # Vraiment inutile
        fi
    fi
    
    return 1  # Fichier potentiellement utile
}

# Fonction INTELLIGENTE pour identifier les dossiers vraiment inutiles
is_truly_useless_directory() {
    local dir="$1"
    
    # 1. CACHES (toujours inutiles)
    if [[ "$dir" == .pytest_cache ]] || [[ "$dir" == .mypy_cache ]] || \
       [[ "$dir" == .ruff_cache ]] || [[ "$dir" == __pycache__ ]] || \
       [[ "$dir" == .tox ]] || [[ "$dir" == .cache ]] || \
       [[ "$dir" == build ]] || [[ "$dir" == dist ]] || \
       [[ "$dir" == htmlcov ]]; then
        return 0  # Vraiment inutile
    fi
    
    # 2. DOSSİERS TEMPORAIRES (toujours inutiles)
    if [[ "$dir" == tmp ]] || [[ "$dir" == temp ]] || [[ "$dir" == .tmp ]] || [[ "$dir" == .temp ]]; then
        return 0  # Vraiment inutile
    fi
    
    # 3. DOSSİERS DE COUVERTURE (toujours inutiles)
    if [[ "$dir" == coverage_html ]] || [[ "$dir" == cov_html ]]; then
        return 0  # Vraiment inutile
    fi
    
    return 1  # Dossier potentiellement utile
}

# =============================================================================
# SECTION 4: NETTOYAGE INTELLIGENT
# =============================================================================

# Nettoyage intelligent des fichiers cachés macOS
clean_macos_hidden_files() {
    print_section "🧠 Nettoyage INTELLIGENT des fichiers cachés macOS"
    
    local patterns=("._*" ".DS_Store" ".!*")
    local cleaned=0
    
    for pattern in "${patterns[@]}"; do
        print_verbose "Recherche de pattern: $pattern"
        
        while IFS= read -r -d '' file; do
            if [ "$DRY_RUN_MODE" = true ]; then
                echo -e "${YELLOW}   [DRY-RUN] Fichier caché macOS: $file${NC}"
                cleaned=$((cleaned + 1))
            else
                if rm -f "$file" 2>/dev/null; then
                    print_success "Supprimé: $file"
                    cleaned=$((cleaned + 1))
                    CLEANED_COUNT=$((CLEANED_COUNT + 1))
                else
                    print_warning "Impossible de supprimer: $file"
                fi
            fi
        done < <(find . -name "$pattern" -type f -not -path "./.git/*" -not -path "./.venv/*" -not -path "./venv/*" -print0 2>/dev/null || true)
    done
    
    if [ $cleaned -gt 0 ]; then
        print_success "Total fichiers cachés macOS: $cleaned"
    else
        print_info "Aucun fichier caché macOS trouvé"
    fi
}

