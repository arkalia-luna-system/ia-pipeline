    local cache_dirs=(".pytest_cache" ".mypy_cache" ".ruff_cache" "__pycache__" ".tox" ".cache" "build" "dist" "htmlcov")
    local cleaned=0
    
    for cache_dir in "${cache_dirs[@]}"; do
        if [ -d "$cache_dir" ]; then
