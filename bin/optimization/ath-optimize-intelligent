#!/bin/bash

# Script d'optimisation intelligente pour Athalia
# Optimise les performances du système macOS de manière intelligente

set -e

# Couleurs pour l'affichage
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Obtenir le répertoire du script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$(dirname "$SCRIPT_DIR")")"

# Dossiers à optimiser (chemins relatifs)
OPTIMIZATION_DIRS=(
    "$PROJECT_ROOT/node_modules"
    "$PROJECT_ROOT/venv"
    "$PROJECT_ROOT/.venv"
    "$PROJECT_ROOT/__pycache__"
    "$PROJECT_ROOT/.git"
    "$PROJECT_ROOT/build"
    "$PROJECT_ROOT/dist"
    "$PROJECT_ROOT/cache"
    "$PROJECT_ROOT/logs"
    "$PROJECT_ROOT/htmlcov"
    "$PROJECT_ROOT/backups"
    "$PROJECT_ROOT/archive"
    "$PROJECT_ROOT/.pytest_cache"
    "$PROJECT_ROOT/.mypy_cache"
    "$PROJECT_ROOT/coverage"
)

echo -e "${BLUE}🧠 Démarrage de l'optimisation intelligente Athalia...${NC}"

# Fonction pour vérifier si un dossier existe
check_directory() {
    if [ -d "$1" ]; then
        return 0
    else
        return 1
    fi
}

# Fonction pour optimiser un dossier
optimize_directory() {
    local dir="$1"
    local dir_name=$(basename "$dir")
    
    if check_directory "$dir"; then
        echo -e "${YELLOW}📁 Optimisation intelligente de $dir_name...${NC}"
        
        # Désactiver l'indexation Spotlight
        mdutil -i off "$dir" 2>/dev/null || true
        
        # Nettoyer les caches
        if [ "$dir_name" = "__pycache__" ] || [ "$dir_name" = ".pytest_cache" ] || [ "$dir_name" = ".mypy_cache" ]; then
            find "$dir" -name "*.pyc" -delete 2>/dev/null || true
            find "$dir" -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
            find "$dir" -name ".pytest_cache" -type d -exec rm -rf {} + 2>/dev/null || true
            find "$dir" -name ".mypy_cache" -type d -exec rm -rf {} + 2>/dev/null || true
        fi
        
        echo -e "${GREEN}✅ $dir_name optimisé intelligemment${NC}"
    else
        echo -e "${YELLOW}⚠️  $dir_name n'existe pas, ignoré${NC}"
    fi
}

# Optimiser tous les dossiers
for dir in "${OPTIMIZATION_DIRS[@]}"; do
    optimize_directory "$dir"
done

# Nettoyage intelligent du système
echo -e "${BLUE}🧹 Nettoyage intelligent du système...${NC}"

# Nettoyer les caches système
sudo rm -rf /Library/Caches/* 2>/dev/null || true
sudo rm -rf /System/Library/Caches/* 2>/dev/null || true

# Nettoyer les caches utilisateur
rm -rf ~/Library/Caches/* 2>/dev/null || true
rm -rf ~/Library/Logs/* 2>/dev/null || true

# Nettoyer les fichiers temporaires
sudo rm -rf /tmp/* 2>/dev/null || true
sudo rm -rf /var/tmp/* 2>/dev/null || true

echo -e "${GREEN}🎉 Optimisation intelligente terminée avec succès !${NC}"
echo -e "${BLUE}💡 Votre Mac est maintenant optimisé intelligemment${NC}" 