"""
Template pour l'API principale - {{ project_name }}

Ce fichier est généré automatiquement par Athalia.
Modifiez-le selon vos besoins spécifiques.
"""

from fastapi import FastAPI, HTTPException, Depends
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from typing import List, Optional
import uvicorn
import os
from datetime import datetime

# Configuration de l'application
app = FastAPI(
    title="{{ project_name }}",
    description="API générée par Athalia",
    version="1.0.0",
    docs_url="/docs",
    redoc_url="/redoc"
)

# Configuration CORS
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Modèles Pydantic
class HealthResponse(BaseModel):
    status: str
    timestamp: datetime
    version: str

class ErrorResponse(BaseModel):
    error: str
    detail: Optional[str] = None

# Routes de base
@app.get("/", response_model=dict)
async def root():
    """Route racine de l'API."""
    return {
        "message": "Bienvenue sur {{ project_name }}",
        "version": "1.0.0",
        "generated_by": "Athalia"
    }

@app.get("/health", response_model=HealthResponse)
async def health_check():
    """Vérification de l'état de l'API."""
    return HealthResponse(
        status="healthy",
        timestamp=datetime.utcnow(),
        version="1.0.0"
    )

@app.get("/api/items", response_model=List[dict])
async def get_items():
    """Récupération des éléments."""
    return [
        {"id": 1, "name": "Item 1", "description": "Description de l'item 1"},
        {"id": 2, "name": "Item 2", "description": "Description de l'item 2"}
    ]

@app.get("/api/items/{item_id}", response_model=dict)
async def get_item(item_id: int):
    """Récupération d'un élément par ID."""
    if item_id < 1:
        raise HTTPException(status_code=400, detail="ID invalide")
    
    return {
        "id": item_id,
        "name": f"Item {item_id}",
        "description": f"Description de l'item {item_id}"
    }

# Gestionnaire d'erreurs global
@app.exception_handler(HTTPException)
async def http_exception_handler(request, exc):
    """Gestionnaire d'erreurs HTTP personnalisé."""
    return ErrorResponse(
        error=exc.detail,
        detail=f"Erreur {exc.status_code} sur {request.url.path}"
    )

# Point d'entrée principal
if __name__ == "__main__":
    port = int(os.getenv("PORT", 8000))
    debug = os.getenv("DEBUG", "false").lower() == "true"
    
    uvicorn.run(
        "main:app",
        host="0.0.0.0",
        port=port,
        reload=debug,
        log_level="info" if not debug else "debug"
    )
