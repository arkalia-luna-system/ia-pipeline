# Exclure tous les fichiers AppleDouble et macOS
global-exclude *._*
global-exclude .DS_Store
global-exclude ._*
global-exclude .AppleDouble
global-exclude .LSOverride
global-exclude Icon?
global-exclude Thumbs.db
global-exclude ehthumbs.db
global-exclude Desktop.ini

# Exclure les dossiers de cache
global-exclude __pycache__
global-exclude .pytest_cache
global-exclude .mypy_cache
global-exclude .ruff_cache
global-exclude .coverage
global-exclude htmlcov
global-exclude .tox
global-exclude .venv
global-exclude venv
global-exclude env
global-exclude .env

# Exclure les fichiers de build
global-exclude build
global-exclude dist
global-exclude *.egg-info
global-exclude *.egg

# Exclure les fichiers de développement
global-exclude .git
global-exclude .gitignore
global-exclude .editorconfig
global-exclude .pre-commit-config.yaml
global-exclude .flake8
global-exclude .pylintrc
global-exclude .mypy.ini
global-exclude .ruff.toml
global-exclude .black
global-exclude .isort.cfg

# Exclure les fichiers de documentation temporaires
global-exclude site
global-exclude docs/_build
global-exclude docs/site

# Exclure les fichiers de logs
global-exclude *.log
global-exclude logs
global-exclude .logs

# Exclure les fichiers de test
global-exclude .pytest_cache
global-exclude .coverage
global-exclude htmlcov
global-exclude .tox
global-exclude .cache

# Exclure les fichiers de backup
global-exclude *.bak
global-exclude *.backup
global-exclude *.tmp
global-exclude *.temp
global-exclude *~
global-exclude #*#
global-exclude .#*

# Exclure les fichiers de système
global-exclude .DS_Store
global-exclude .Trashes
global-exclude .Spotlight-V100
global-exclude .fseventsd
global-exclude .TemporaryItems
global-exclude .VolumeIcon.icns
global-exclude .com.apple.timemachine.donotpresent

